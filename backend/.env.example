# --- Orbit API configuration ---
PORT=8000
# MongoDB connection string and database name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=orbit
# Change this to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API from another domain (not needed when the API serves the app)
CORS_ORIGIN=http://localhost:5173
# Create the demo account (demo@orbit.app / orbit123) with sample data on startup
SEED_DEMO=true
# Serve the built frontend from this folder (leave empty to run API-only)
FRONTEND_DIST=../frontend/dist
# Optional: read syllabi (incl. scanned PDFs and photos) with Claude. Leave empty to use the built-in parser.
ANTHROPIC_API_KEY=
