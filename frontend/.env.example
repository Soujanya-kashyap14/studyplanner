# true  -> runs entirely on in-browser mock data (no backend needed)
# false -> calls the Express + MongoDB backend
VITE_USE_MOCK=false
# '/api' = same origin: Vite proxies it to the backend in dev; the backend serves the app in production.
VITE_API_BASE_URL=/api
# Show the "Explore the demo account" button on the login page
VITE_DEMO_LOGIN=true
